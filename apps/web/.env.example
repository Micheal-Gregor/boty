# Supabase — copy this file to .env and fill in your project's values.
# Find these in the Supabase dashboard → Project Settings → API.
# The anon key is safe to expose in the client (it's protected by Row Level Security),
# but .env stays gitignored so values aren't committed.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
