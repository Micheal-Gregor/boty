{
  "name": "boty",
  "private": true,
  "version": "0.1.0",
  "description": "Business of the Year (Order to Cash) — monorepo: the game engine and (later) the web/mobile client.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @boty/web",
    "build:web": "npm run build --workspace @boty/web",
    "test": "npm test --workspace @boty/engine",
    "tune": "npm run tune --workspace @boty/engine",
    "start": "npm start --workspace @boty/engine"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
